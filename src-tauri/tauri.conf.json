{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Canto",
  "version": "0.3.0",
  "identifier": "com.junin.canto",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Canto",
        "width": 420,
        "height": 580,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false,
        "minWidth": 360,
        "minHeight": 440,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDNjdDMkI0MjlCOEEzNDEKUldSQm83Z3B0TUpuako5VzlXYmROQTJVREk3d254KzhiaFo5QnNONUJ2UFNObjVtS1BZMGhDV2QK",
      "endpoints": ["https://github.com/juninmd/canto-widget/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Antonio Carlos",
    "copyright": "Copyright (c) 2026 Antonio Carlos. Licença MIT.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/juninmd/canto-widget",
    "category": "Productivity",
    "shortDescription": "Tarefas, notas e agenda cifradas no canto da tela",
    "longDescription": "Widget de desktop com checklist do dia, notas pesquisáveis, clipboard local, transcrições de reuniões, agenda do Google e issues e PRs do GitHub. Tudo cifrado em disco com a senha mestra.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
